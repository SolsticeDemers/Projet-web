{% extends "_modele.jinja" %}

{% block contenu %}

<div class="container my-4 page-vintage">

    <div class="row details-produit-vintage">

        <div class="col-md-6 details-image-vintage">

            <img
                src="{{ img_source }}"
                alt="{{ produit.nom }}"
                class="img-fluid"
            >

        </div>

        <div class="col-md-6 details-info-vintage">

            <div class="mb-3">

                <h2 class="fw-bold px-3 pt-2 mb-0">
                    {{ produit.nom }}
                </h2>

                <p class="px-3 pb-2 mb-0 details-vendeur">

                    <a
                        href="{{ url_for('compte.profil_public', id_utilisateur=vendeur.id_utilisateur) }}"
                        class="lien-profil-public"
                    >
                        {{ vendeur.nom }}
                    </a>

                </p>

            </div>


            <div class="prix p-2 mb-3 details-prix">

                <p>
                    Mise actuelle : {{ produit.prix }} $
                </p>

                {% if produit.date_fin %}

                    <p class="fs-6 fw-normal">
                        Fin de l'enchère : {{ produit.date_fin }}
                    </p>

                {% endif %}

            </div>


            <div class="p-2 mb-3 details-description">

                <p>
                    {{ produit.description }}
                </p>

            </div>


            <form method="post" novalidate class="formulaire-vintage">

                <div class="mb-3">

                    <label for="mise" class="form-label">
                        Votre mise
                    </label>

                    <input
                        type="number"
                        name="mise"
                        id="mise"
                        step="0.01"
                        placeholder="Votre mise"
                        class="form-control {% if erreur %}is-invalid{% endif %}"
                    >

                    {% if erreur %}

                        <p class="invalid-feedback">
                            {{ erreur }}
                        </p>

                    {% endif %}

                </div>


                <div class="actions mt-3">

                    <button
                        type="submit"
                        class="button btn-vintage"
                    >
                        Miser
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

{% endblock %}