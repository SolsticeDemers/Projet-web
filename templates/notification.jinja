{% extends "_modele.jinja" %}

{% block contenu %}

<section class="container my-4 page-vintage">


<div class="notification-section">

    <h2>
        Notification d'échange
    </h2>


    <ul class="liste-mes-produits">


        {% for notif in notifications_echange %}


        {% if session['nom'] == notif.offrant and notif.approuve != None %}


        <li class="carte-produit carte-mon-produit affichage_notif notification-vintage">

            <div id="notif_detail">


                <p id="nom_offrant">
                    <strong>{{ notif.offrant }}</strong>
                </p>


                <p>
                    Votre produit:
                    <a href="/produits/{{ notif.id_produit }}">
                        {{ notif.echange_nom }}
                    </a>
                </p>


                <p>
                    Le produit offert:
                    <a href="/produits/{{ notif.id_produit_offert }}">
                        {{ notif.offert_nom }}
                    </a>
                </p>


                {% if notif.approuve == 1 %}

                <p
                    class="alert theme-success"
                    role="alert"
                >
                    Votre demande d'échange à été approuvé!
                </p>


                {% elif notif.approuve == 0 %}

                <p
                    class="alert theme-danger"
                    role="alert"
                >
                    Votre demande d'échange à été refusé!
                </p>

                {% endif %}


            </div>

        </li>



        {% elif session['nom'] == notif.proprio and notif.approuve == None %}


        <li class="carte-produit carte-mon-produit affichage_notif notification-vintage">


            <div id="notif_detail">


                <p id="nom_offrant">
                    <strong>{{ notif.offrant }}</strong>
                </p>


                <p>
                    Votre produit:
                    <a href="/produits/{{ notif.id_produit }}">
                        {{ notif.echange_nom }}
                    </a>
                </p>


                <p>
                    Le produit offert:
                    <a href="/produits/{{ notif.id_produit_offert }}">
                        {{ notif.offert_nom }}
                    </a>
                </p>


            </div>


            <div class="actions actions-notification">


                <a
                    class="btn-accepter btn-vintage-accepter"
                    href="/compte/accepter_echange/{{notif.id_proposition}}/oui"
                    id="echange_accepter"
                    value="oui"
                >
                    Accepter
                </a>


                <a
                    class="btn-refuser btn-vintage-danger"
                    href="/compte/accepter_echange/{{notif.id_proposition}}/non"
                    id="echange_refuser"
                    value="non"
                >
                    Refuser
                </a>


            </div>


        </li>


        {% endif %}


        {% endfor %}


    </ul>

</div>



<div class="notification-section">


    <h2>
        Notifications d'achat
    </h2>


    <ul class="liste-mes-produits">


        {% for notif in notifications_achat %}


        <li class="carte-produit carte-mon-produit affichage_notif notification-vintage">

            <p>

                Votre produit

                <a href="{{ url_for('produits.details_produit', id=notif.id_produit) }}">
                    {{ notif.nom_produit }}
                </a>

                a été acheté par {{ notif.nom_acheteur }} pour {{ notif.prix_achat }} $.

            </p>

        </li>


        {% else %}


        <li class="list-unstyled">
            Vous n'avez aucune notification d'achat
        </li>


        {% endfor %}


    </ul>

</div>


</section>

{% endblock %}