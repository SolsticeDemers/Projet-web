{% extends "_modele.jinja" %}

{% block contenu %}

<div>
    <h2>Notification d'échange</h2>
    <ul>
        {% for notif in notifications_echange %}
        {% if session['nom'] == notif.offrant and notif.approuve != None %}
        <li>

            <span class="badge-statut-notif badge-echange">
                {{ notif.status }}
            </span>

            {% if notif.approuve == 1 %}
            <p><strong>{{notif.proprio}}</strong></p>
            <p>Le produit convoité: {{notif.echange_nom}}</p>
            <p>Votre produit: {{notif.offert_nom}}</p>
            <p>Votre demande d'échange à été approuvé!</p>

            {% elif notif.approuve == 0 %}
            <p><strong>{{notif.proprio}}</strong></p>
            <p>Le produit convoité: {{notif.echange_nom}}</p>
            <p>Votre produit: {{notif.offert_nom}}</p>
            <p>Votre demande d'échange à été refusé!</p>

            {% endif %}



        </li>
        
        {% elif session['nom'] == notif.proprio and notif.approuve == None %}
        <li>
            <span class="badge-statut-notif badge-echange">
                {{ notif.status }}
            </span>
            <p id="nom_offrant"><strong>{{notif.offrant}}</strong></p>
            <p>Votre produit: {{notif.echange_nom}}</p>
            <p>Le produit offert: {{notif.offert_nom}}</p>
            <p>Commentaire du produit:</p>
            <p>{{notif.commentaire}}</p>
            <a href="/compte/accepter_echange/{{notif.id_proposition}}/oui" id="echange_accepter"
                value="oui">Accepter</a>
            <a href="/compte/accepter_echange/{{notif.id_proposition}}/non" id="echange_refuser" value="non">Refuser</a>
        </li>
        {% endif %}

        {% endfor %}
    </ul>
</div>

{% endblock %}