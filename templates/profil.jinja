{% extends "_modele.jinja" %}

{% block contenu %}

<div class="container my-4">

    <h2>Profil de {{ session['nom'] }}</h2>

    <p>Email : {{ session['email'] }}</p>
    <p>Nom : {{ session['nom'] }}</p>
    <p>Prénom : {{ session['prenom'] }}</p>

    <div class="actions">

        <a
            href="/produits/ajouter_produit"
            class="button"
        >
            Ajouter un produit
        </a>

        <a
            href="{{ url_for('produits.mes_produits') }}"
            class="button"
        >
            Mes produits
        </a>

        <a
            href="{{ url_for('produits.mes_encheres') }}"
            class="button"
        >
            Mes enchères
        </a>

        <a
            href="{{ url_for('produits.historique_transaction') }}"
            class="button"
        >
            Historique des transactions
        </a>

    </div>

</div>

{% endblock %}