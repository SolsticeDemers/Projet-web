{% extends "_modele.jinja" %}

{% block contenu %}

<section class="container my-4 page-profil">

    <div class="profil-entete">

        <div class="d-flex flex-column align-items-center">

            <img src="{{ image_vendeur }}" alt="Image de profil de {{ utilisateur.nom }}" class="profil-avatar">

        </div>


        <div class="profil-informations">

            <h3>
                {{ utilisateur.nom }}
            </h3>

            <a
                href="{{ url_for('compte.modifier_profil') }}"
                class="lien-modifier-profil"
            >
                Modifier mon profil
            </a>

            <p>
                <strong>Nom d'utilisateur :</strong>
                {{ utilisateur.nom }}
            </p>

            <p>
                <strong>Courriel :</strong>
                {{ utilisateur.courriel }}
            </p>

        </div>


        <div class="actions profil-actions">

            <a
                href="{{ url_for('notification.notification') }}"
                class="bouton-secondaire"
            >
                <span>Mes notifications</span>
            </a>

            <a
                href="{{ url_for('produits.mes_encheres') }}"
                class="bouton-secondaire"
            >
                <span>Mes enchères misées</span>
            </a>

            <a
    href="{{ url_for('produits.transactions') }}"
    class="bouton-secondaire"
>
    <span>Mes transactions</span>
</a>

            <a
                href="/produits/ajouter_produit"
                class="bouton-secondaire"
            >
                <span>Ajouter un produit</span>
            </a>

        </div>

    </div>

</section>



<section class="container my-4 page-profil">

    <h2 class="titre-mes-produits">
        Mes produits
    </h2>


    {% if produits %}

    <div class="liste-mes-produits">

        {% for produit in produits %}
        {% if request.cookies.get('mode_echange') == 'True' and produit.nom_statut != "Vendu" %}

        <div class="carte-produit carte-mon-produit">

            <div class="image-produit">

                <a href="/produits/{{ produit.id_produit }}">

                    <img src="{{ produit.src or url_for('static', filename='images/default.png') }}"
                        alt="{{ produit.nom }}">

                </a>

                <span class="badge-statut badge-{{ produit.code_statut }}">
                    {{ produit.nom_statut }}
                </span>

            </div>


            <div class="contenu-produit">

                <h3>

                    <a href="/produits/{{ produit.id_produit }}">
                        {{ produit.nom }}
                    </a>

                </h3>

                <p>
                    {{ produit.description }}
                </p>

                <p class="prix">
                    {{ produit.prix }} $
                </p>
            </div>

            <div class="actions">
                
                <a href="/notification/creer_echange/{{produit.id_produit}}">Choisir</a>
                
            </div>

        </div>
        {% elif  request.cookies.get('mode_echange') == 'False' %}
        {# {% else %} #}
        <div class="carte-produit carte-mon-produit">

            <div class="image-produit">

                <a href="/produits/{{ produit.id_produit }}">

                    <img src="{{ produit.src or url_for('static', filename='images/default.png') }}"
                        alt="{{ produit.nom }}">

                </a>

                <span class="badge-statut badge-{{ produit.code_statut }}">
                    {{ produit.nom_statut }}
                </span>

            </div>


            <div class="contenu-produit">

                <h3>

                    <a href="/produits/{{ produit.id_produit }}">
                        {{ produit.nom }}
                    </a>

                </h3>

                <p>
                    {{ produit.description }}
                </p>

                <p class="prix">
                    {{ produit.prix }} $
                </p>
            </div>

            <div class="actions">
                
                <a href="{{ url_for('produits.modifier_produit', id=produit.id_produit) }}" class="btn-modifier">
                    Modifier
                </a>

                <form action="{{ url_for('produits.archiver_produit', id=produit.id_produit) }}" method="post">

                    {{ form_archiver.hidden_tag() }}

                    <button type="submit" class="btn-supprimer">
                        Supprimer
                    </button>

                </form>
                
            </div>

                </div>


                {% if not loop.last %}

                    <div class="separateur-produits-profil">
                        <span></span>
                    </div>

                {% endif %}

            {% endfor %}

    </div>

    {% else %}

        <p class="aucun-produit">
            Vous n'avez ajouté aucun produit.
        </p>

    {% endif %}

</section>

{% endblock %}