{% extends "_modele.jinja" %}

{% block contenu %}
<div class="container my-4">
    <h2>Profil de {{ utilisateur.nom }}</h2>
    <p>Nom d'utilisateur : {{ utilisateur.nom }}</p>
    <p>Courriel : {{ utilisateur.courriel }}</p>

</div>

<section class="container my-4">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
        <h2 class="m-5">Mes produits</h2>

        <div class="actions">
            <a href="/produits/ajouter_produit" class="button">Ajouter un produit</a>
        </div>
    </div>

    {% if produits %}
    <div class="liste-mes-produits">

        {% for produit in produits %}
        <div class="carte-produit carte-mon-produit">

            <div class="image-produit">
                <a href="/produits/{{ produit.id_produit }}">
                    {% if produit.src %}
                    <img src="{{ produit.src }}" alt="{{ produit.nom }}">
                    {% endif %}
                </a>

                <span class="badge-statut badge-{{ produit.code_statut }}">
                    {{ produit.nom_statut }}
                </span>
            </div>

            <div class="contenu-produit">
                <h3>
                    <a href="/produits/{{ produit.id_produit }}">
                        {{ produit.nom }}
                    </a>
                </h3>

                <p>
                    {{ produit.description }}
                </p>

                <p class="prix">
                    {{ produit.prix }} $
                </p>
            </div>

            <div class="actions">

                <a href="{{ url_for('produits.modifier_produit', id=produit.id_produit) }}" class="btn-modifier">
                    Modifier
                </a>




                <form action="{{ url_for('produits.archiver_produit', id=produit.id_produit) }}" method="post">

                    {{ form_archiver.hidden_tag() }}

                    <button type="submit" class="btn-supprimer">
                        Supprimer
                    </button>

                </form>

            </div>

        </div>
        {% endfor %}

    </div>

    {% else %}

    <p>
        Vous n'avez ajouté aucun produit.
    </p>

    {% endif %}

</section>

{% endblock %}