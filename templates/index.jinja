                        </a>

                    </div>

                </div>

            </div>

        {% endfor %}

    </div>


    <div class="voir-plus">

        <a href="{{ url_for('recherche_produits') }}">

            Voir Plus

            <i class="bi bi-caret-down-fill"></i>

        </a>

    </div>

</section>

{% endblock %}