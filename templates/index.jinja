{% extends "_modele.jinja" %}

{% block contenu %}

<section class="hero-carousel">

    <div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel">

        <div class="carousel-inner">

            <div class="carousel-item active">

                <img
                    class="d-block w-100"
                    src="{{ url_for('static', filename='images/carousel1.jpg') }}"
                    alt="Vintage Market"
                >

                <div class="carousel-filtre"></div>

                <div class="carousel-contenu">

                    <h1>
                        Découvrez des objets uniques
                    </h1>

                    <p>
                        Achetez, échangez et trouvez des objets qui ont une histoire
                    </p>

                    <a href="#nouveaux-produits" class="bouton-hexagone">
                        Découvrir
                    </a>

                </div>

            </div>

            <div class="carousel-item">

                <img
                    class="d-block w-100"
                    src="{{ url_for('static', filename='images/carousel2.jpg') }}"
                    alt="Enchères Vintage Market"
                >

                <div class="carousel-filtre"></div>

                <div class="carousel-contenu">

                    <h1>
                        Des enchères à ne pas manquer
                    </h1>

                    <p>
                        Misez sur des objets rares et tentez de remporter vos favoris
                    </p>

                    <a href="#futures-encheres" class="bouton-hexagone">
                        Enchères
                    </a>

                </div>

            </div>

        </div>

        <a
            class="carousel-control-prev"
            href="#carouselExampleControls"
            role="button"
            data-bs-slide="prev"
        >

            <span class="carousel-control-prev-icon" aria-hidden="true"></span>

            <span class="visually-hidden">
                Précédent
            </span>

        </a>

        <a
            class="carousel-control-next"
            href="#carouselExampleControls"
            role="button"
            data-bs-slide="next"
        >

            <span class="carousel-control-next-icon" aria-hidden="true"></span>

            <span class="visually-hidden">
                Suivant
            </span>

        </a>

    </div>

</section>


<section class="separateur-accueil">

    <h2>
        Achetez, échangez et bien plus…
    </h2>

</section>


<section class="section-video">

    <video class="video-accueil" autoplay muted loop playsinline>

        <source
            src="{{ url_for('static', filename='images/video.mp4') }}"
            type="video/mp4"
        >

    </video>

    <div class="video-filtre"></div>

    <div class="video-contenu">

        {% if session.get('id_utilisateur') %}

            <a href="/panier/" class="bouton-hexagone bouton-panier-video">
                Votre panier
            </a>

        {% else %}

            <a href="/compte/creer_compte" class="bouton-hexagone bouton-panier-video">
                Connectez-vous
            </a>

        {% endif %}

    </div>

</section>


<section class="section-produits" id="nouveaux-produits">

    <div class="titre-section nouveau">

        <h2>
            Nouveautés
        </h2>

        <div class="titre-etoiles">

            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>

        </div>

    </div>

    <div class="grille-produits">

        {% for produit in nouveaux_produits %}


            <div class="carte-produit">

                <div class="image-produit">

                    {% if produit.src %}

                        <a href="/produits/{{ produit.id_produit }}" class="d-block w-100 h-100">

                            <img
                                src="{{ produit.src }}"
                                alt="{{ produit.nom }}"
                            >

                        </a>

                    {% endif %}

                    <span class="badge-statut
                        {% if produit.nom_statut == 'En vente' %}
                            badge-vente
                        {% elif produit.nom_statut == 'Aux enchères' %}
                            badge-enchere
                        {% elif produit.nom_statut == 'À échanger' %}
                            badge-echange
                        {% endif %}
                    ">
                        {{ produit.nom_statut }}
                    </span>

                </div>

                <div class="contenu-produit">

                    <h3>
                        {{ produit.nom }}
                    </h3>

                    <p class="prix">
                        {{ produit.prix }} $
                    </p>

                    <div class="actions">

                    {% if "id_utilisateur" in session %}
                    {% if session['id_utilisateur'] != produit.id_vendeur %}

                            {% if produit.nom_statut == 'En vente' %}

                                <form method="POST" action="/panier/ajouter/{{ produit.id_produit }}">

                                    {{ form_panier.hidden_tag() }}

                                    <button type="submit" class="btn-action-produit">
                                        Ajouter
                                    </button>

                                </form>

                            {% elif produit.nom_statut == 'Aux enchères' %}

                                <a
                                    href="{{ url_for('produits.miser_produit', id=produit.id_produit) }}"
                                    class="btn-action-produit"
                                >
                                    Enchérir
                                </a>

                            {% elif produit.nom_statut == 'À échanger' %}

                    <form method="GET" action="/notification/faire_echange/{{ produit.id_produit }}">

                        {{ form_panier.hidden_tag() }}

                        <button type="submit">
                            Échanger
                        </button>

                    </form>

                    {% endif %}



                            {% endif %}

                        {% endif %}

                        <a href="/produits/{{ produit.id_produit }}" class="btn-details-produit">
                            Détails
                        </a>

                    </div>

                </div>

            </div>

        {% endfor %}

    </div>

</section>


<section class="section-produits nouveau" id="futures-encheres">

    <div class="titre-section nouveau">

        <h2>
            Enchères à venir
        </h2>

        <div class="titre-etoiles-enchere">

            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>

        </div>

    </div>

    <div class="grille-produits">

        {% for produit in encheres_futures %}

            <div class="carte-produit">

                <div class="image-produit">

                    {% if produit.src %}

                        <a href="/produits/{{ produit.id_produit }}" class="d-block w-100 h-100">

                            <img
                                src="{{ produit.src }}"
                                alt="{{ produit.nom }}"
                            >

                        </a>

                    {% endif %}

                    <span class="badge-statut
                        {% if produit.nom_statut == 'En vente' %}
                            badge-vente
                        {% elif produit.nom_statut == 'Aux enchères' %}
                            badge-enchere
                        {% elif produit.nom_statut == 'À échanger' %}
                            badge-echange
                        {% endif %}
                    ">
                        {{ produit.nom_statut }}
                    </span>

                </div>

                <div class="contenu-produit">

                    <h3>
                        {{ produit.nom }}
                    </h3>

                    <p class="prix">
                        {{ produit.prix }} $
                    </p>

                    <div class="actions">

                    {% if "id_utilisateur" in session %}
                    {% if session['id_utilisateur'] != produit.id_vendeur %}
                    {% if produit.nom_statut == 'En vente' %}

                                <form method="POST" action="/panier/ajouter/{{ produit.id_produit }}">

                                    {{ form_panier.hidden_tag() }}

                                    <button type="submit" class="btn-action-produit">
                                        Ajouter
                                    </button>

                                </form>

                            {% elif produit.nom_statut == 'Aux enchères' %}

                                <a
                                    href="{{ url_for('produits.miser_produit', id=produit.id_produit) }}"
                                    class="btn-action-produit"
                                >
                                    Enchérir
                                </a>

                    {% elif produit.nom_statut == 'À échanger' %}
                    <form method="GET" action="/notification/faire_echange/{{ produit.id_produit }}">

                        {{ form_panier.hidden_tag() }}

                        <button type="submit">
                            Échanger
                        </button>

                    </form>

                    {% endif %}
                    {% endif %}

                        {% endif %}

                        <a href="/produits/{{ produit.id_produit }}" class="btn-details-produit">
                            Détails
                        </a>

                    </div>


            </div>


        </div>

        {% endfor %}

    </div>

</section>


{% if produit_du_jour %}

    <section class="produit-vedette">

        <div class="vedette-info">

            <span class="badge-statut
                {% if produit_du_jour.nom_statut == 'En vente' %}
                    badge-vente
                {% elif produit_du_jour.nom_statut == 'Aux enchères' %}
                    badge-enchere
                {% elif produit_du_jour.nom_statut == 'À échanger' %}
                    badge-echange
                {% endif %}
            ">
                {{ produit_du_jour.nom_statut }}
            </span>

            <h2>
                {{ produit_du_jour.nom }}
            </h2>

            <p>
                {{ produit_du_jour.description }}
            </p>

            <p class="prix">
                {{ produit_du_jour.prix }} $
            </p>

            <div class="actions">

            {% if "id_utilisateur" in session %}
            {% if session['id_utilisateur'] != produit_du_jour.id_vendeur %}
            {% if produit_du_jour.nom_statut == "En vente" %}

                        <form method="POST" action="/panier/ajouter/{{ produit_du_jour.id_produit }}">

                            {{ form_panier.hidden_tag() }}

                            <button type="submit" class="btn-action-produit">
                                Ajouter
                            </button>

                        </form>

                    {% elif produit_du_jour.nom_statut == 'Aux enchères' %}

                        <a
                            href="{{ url_for('produits.miser_produit', id=produit_du_jour.id_produit) }}"
                            class="btn-action-produit"
                        >
                            Enchérir
                        </a>

            {% elif produit_du_jour.nom_statut == "À échanger" %}
            <form method="GET" action="/notification/faire_echange/{{ produit_du_jour.id_produit }}">

                {{ form_panier.hidden_tag() }}

                <button type="submit">
                    Échanger
                </button>

            </form>

            {% endif %}
            {% endif %}

                {% endif %}

                <a href="/produits/{{ produit_du_jour.id_produit }}" class="btn-details-produit">
                    Détails
                </a>

            </div>

        </div>

        <div class="vedette-image">

            {% if produit_du_jour.src %}

                <a href="/produits/{{ produit_du_jour.id_produit }}" class="d-block w-100 h-100">

                    <img
                        src="{{ produit_du_jour.src }}"
                        alt="{{ produit_du_jour.nom }}"
                    >

                </a>

            {% endif %}

        </div>

    </section>

{% endif %}


<section class="section-produits">

    <div class="titre-section nouveau">

        <h2>
            Nos produits
        </h2>

        <div class="titre-etoiles-nosproduits">

            <i class="bi bi-star-fill e1"></i>
            <i class="bi bi-star-fill e2"></i>
            <i class="bi bi-star-fill e3"></i>

        </div>

    </div>

    <div class="grille-produits">

        {% for produit in produits_aleatoires %}


            <div class="carte-produit">

                <div class="image-produit">

                    {% if produit.src %}

                        <a href="/produits/{{ produit.id_produit }}" class="d-block w-100 h-100">

                            <img
                                src="{{ produit.src }}"
                                alt="{{ produit.nom }}"
                            >

                        </a>

                    {% endif %}

                    <span class="badge-statut
                        {% if produit.nom_statut == 'En vente' %}
                            badge-vente
                        {% elif produit.nom_statut == 'Aux enchères' %}
                            badge-enchere
                        {% elif produit.nom_statut == 'À échanger' %}
                            badge-echange
                        {% endif %}
                    ">
                        {{ produit.nom_statut }}
                    </span>

                </div>

                <div class="contenu-produit">

                    <h3>
                        {{ produit.nom }}
                    </h3>

                    <p class="prix">
                        {{ produit.prix }} $
                    </p>

                    <div class="actions">

                    {% if "id_utilisateur" in session %}
                    {% if session['id_utilisateur'] != produit.id_vendeur %}
                    {% if produit.nom_statut == 'En vente' %}

                                <form method="POST" action="/panier/ajouter/{{ produit.id_produit }}">

                                    {{ form_panier.hidden_tag() }}

                                    <button type="submit" class="btn-action-produit">
                                        Ajouter
                                    </button>

                                </form>

                            {% elif produit.nom_statut == 'Aux enchères' %}

                                <a
                                    href="{{ url_for('produits.miser_produit', id=produit.id_produit) }}"
                                    class="btn-action-produit"
                                >
                                    Enchérir
                                </a>

                            {% elif produit.nom_statut == 'À échanger' %}

                    <form method="GET" action="/notification/faire_echange/{{ produit.id_produit }}">

                        {{ form_panier.hidden_tag() }}

                        <button type="submit">
                            Échanger
                        </button>

                    </form>

                    {% endif %}
                    {% endif %}

                        {% endif %}

                        <a href="/produits/{{ produit.id_produit }}" class="btn-details-produit">
                            Détails
                        </a>

                    </div>

                </div>


        </div>


        {% endfor %}

    </div>

    <div class="voir-plus">

        <a
            href="{{ url_for('recherche_produits') }}"
            class="bouton-hexagone bouton-voir-plus"
        >
            Voir plus
        </a>

    </div>

</section>


<section class="section-vendeurs">

    <div class="cadre-vendeurs">

        <h2>
            Meilleurs vendeurs
        </h2>

        <div class="vendeurs-populaires">

            {% for vendeur in vendeurs %}

                <div class="vendeur-card">

                    <a href="{{ url_for('compte.profil_public', id_utilisateur=vendeur.id_utilisateur) }}">

                        <img
                            src="{{ url_for('static', filename='images/utiles/vendeur_' ~ vendeur.id_utilisateur ~ '.png') }}"
                            alt="{{ vendeur.nom }}"
                        >

                    </a>

                    <a
                        href="{{ url_for('compte.profil_public', id_utilisateur=vendeur.id_utilisateur) }}"
                        class="nom-vendeur"
                    >
                        {{ vendeur.nom }}
                    </a>

                </div>

            {% endfor %}

        </div>

        <div class="separateur-vendeurs">

            <span></span>

        </div>

        <div class="voir-utilisateurs">

            <a href="#" class="bouton-utilisateurs">
                Voir tous les utilisateurs
            </a>

        </div>

    </div>

</section>

{% endblock %}