{% extends "_modele.jinja" %}

{% block contenu %}

<div class="container my-4">
    <div class="row">
        <div class="col-md-6">
            <img src="{{ img_source }}" alt="{{ produit.nom }}" class="img-fluid">
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <h2 class="fw-bold px-3 pt-2 mb-0">{{ produit.nom }}</h2>
                <p class="px-3 pb-2 mb-0 text-muted">{{ vendeur.nom }}</p>
            </div>

            <div class="prix p-2 mb-3">
                <p>Prix : {{ produit.prix }} $</p>
            </div>

            <div class="p-2 mb-3">
                <p>{{ produit.description }}</p>
            </div>
            <div class="actions">
                {% if not est_disponible %}
                    <p class="text-danger">Ce produit n'est plus disponible.</p>
                {% elif not est_connecte %}
                    <a href="/compte/authentification" class="button">Connectez-vous pour acheter</a>
                {% elif not est_vendeur %}
                    <form method="POST" action="/panier/ajouter/{{ produit.id_produit }}">
                        {{ form.hidden_tag() }}
                        <button type="submit" class="button">Ajouter au panier</button>
                    </form>
                {% endif %}
            </div>

        </div>
    </div>
</div>

{% endblock %}