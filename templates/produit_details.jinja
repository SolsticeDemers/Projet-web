{% extends "_modele.jinja" %}

{% block contenu %}

<div class="container my-4">
    <div class="row">
        <div class="col-md-6">
            <img src="{{ img_source }}" alt="{{ produit.nom }}" class="img-fluid border">
        </div>
        <div class="col-md-6">
            <div class="border mb-3">
                <h2 class="fw-bold px-3 pt-2 mb-0">{{ produit.nom }}</h2>
                <p class="px-3 pb-2 mb-0 border-top small text-muted">{{ vendeur.nom }}</p>
            </div>

            <div class="p-2 mb-3">
                Prix : {{ produit.prix }} $
            </div>

            <div class="border p-2 mb-3">
                {{ produit.description }}
            </div>

            <button type="submit" class="btn btn-outline-dark w-100">Acheter</button>
        </div>
    </div>
</div>

{% endblock %}