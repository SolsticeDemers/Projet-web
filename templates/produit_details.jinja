{% extends "_modele.jinja" %}

{% block contenu %}

<div class="container my-4">
    <div class="row">
        <div class="col-md-6">
            <img src="{{ img_source }}" alt="{{ produit.nom }}" class="img-fluid">
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <h2 class="fw-bold px-3 pt-2 mb-0">{{ produit.nom }}</h2>
                <p class="px-3 pb-2 mb-0 text-muted">{{ vendeur.nom }}</p>
            </div>

            <div class="prix p-2 mb-3">
                <p>Prix : {{ produit.prix }} $</p>
            </div>

            <div class="p-2 mb-3">
                <p>{{ produit.description }}</p>
            </div>
            <div class="actions">
                <button type="submit" class="button">Acheter</button>
                {% if est_connecte and produit.id_vendeur == session.id_utilisateur %}
                    <a href="/produits/{{ id }}/modifier" class="button">Modifier</a>
                {% endif %}
            </div>

        </div>
    </div>
</div>

{% endblock %}