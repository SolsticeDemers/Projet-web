<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        {{ titre }} | Vintage Market
    </title>

    <link rel="stylesheet" href="{{ url_for('static', filename='css/styles.css') }}">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        label.required::after {
            content: " *";
            color: red;
            font-weight: bold;
        }
    </style>

</head>


<body>

    <header>

        <nav class="navigation container-fluid">

            <a href="/" class="logo">

                <img src="{{ url_for('static', filename='images/logo.png') }}" alt="Vintage Market">

            </a>


            <form action="/produits/recherche" method="get" class="recherche">

                <input type="search" name="mot_cle" placeholder="Rechercher un produit">

                <button type="submit">
                    Rechercher
                </button>

            </form>


            {% if session['id_utilisateur'] %}

            <div class="connexion connecter">

                <a href="/panier/" class="icone-action" title="Mon panier" aria-label="Mon panier">
                    <i class="bi bi-cart3" aria-hidden="true"></i>

                    {% if nb_articles > 0 %}

                    <span class="badge-compteur">{{ nb_articles }}</span>

                    {% endif %}

                </a>

                <a href="/compte/notification" class="icone-action" title="Notifications" aria-label="Notifications">
                    <i class="bi bi-bell" aria-hidden="true"></i>
                    <span id="nb_notification" class="badge-compteur"></span>
                </a>


                <a href="/compte/profil" class="icone-action" title="Mon profil" aria-label="Mon profil">
                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                </a>


                <a href="/compte/deconnection" class="btn_deconnection">
                    Se déconnecter
                </a>

            </div>

            {% else %}


            <div class="connexion">

                <a href="/compte/authentification">
                    Se connecter
                </a>

            </div>


            {% endif %}

        </nav>

    </header>


    <main>

        {% block contenu %}

        {% endblock %}

    </main>


    <footer class="footer">

        <p>
            Vintage Market © 2026
        </p>

    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ url_for('static', filename='js/utils-ajax.js') }}"></script>
    <script src="{{ url_for('static', filename='js/notification.js') }}"></script>
</body>

</html>