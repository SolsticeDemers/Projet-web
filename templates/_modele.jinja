<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        {{ titre }} | Vintage Market
    </title>

    <link rel="stylesheet" href="{{ url_for('static', filename='css/styles.css') }}">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* Add red asterisk after labels with class 'required' */
        label.required::after {
            content: " *";
            color: red;
            font-weight: bold;
        }
    </style>

</head>


<body>

    <header>

        <nav class="navigation container-fluid">

            <a href="/" class="logo">

                <img src="{{ url_for('static', filename='images/logo.png') }}" alt="Vintage Market">

            </a>


            <form action="/produits/recherche" method="get" class="recherche">

                <input type="search" name="mot_cle" placeholder="Rechercher un produit">

                <button type="submit">
                    Rechercher
                </button>

            </form>


            {% if session['id_utilisateur'] %}
            <div>
                <div class="connexion connecter">

                    <a href="/panier/" class="icone-panier" title="Mon panier">

                        <i class="bi bi-cart3"></i>

                        {% if nb_articles > 0 %}

                        <span class="nb-articles">
                            ({{ nb_articles }})
                        </span>

                        {% endif %}

                    </a>


                    <a href="/compte/profil" class="btn_profil">
                        Profil
                    </a>


                    <a href="/compte/deconnection" class="btn_deconnection">
                        Se déconnecter
                    </a>
                    <a href="/compte/notification" id="btn_notification"><img
                            src="{{ url_for('static', filename='images/bell.png') }}" alt="Notifications"
                            id="img_notif">
                        <p id="nb_notification"></p>
                    </a>
                </div>
            </div>


            {% else %}


            <div class="connexion">

                <a href="/compte/authentification">
                    Se connecter
                </a>

            </div>


            {% endif %}

        </nav>

    </header>


    <main>

        {% block contenu %}

        {% endblock %}

    </main>


    <footer class="footer">

        <p>
            Vintage Market © 2026
        </p>

    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>