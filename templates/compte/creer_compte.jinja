{% extends "_modele.jinja" %}

{% block contenu %}

<div class="page-compte">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-12 col-md-6 col-lg-4">

                <h2 class="mb-4">
                    Créer un compte
                </h2>


                <form
                    method="post"
                    action=""
                    enctype="multipart/form-data"
                    novalidate
                    class="d-grid gap-4"
                >


                    <div class="mb-4">

                        <label
                            for="nom"
                            class="form-label"
                        >
                            Nom d'utilisateur :
                        </label>

                        <input
                            type="text"
                            name="nom"
                            id="nom"
                            value="{{ nom }}"
                            class="{{ classe_nom }} form-control"
                        >


                        {% if num_nom_erreur == 1 %}

                            <p
                                class="invalid-feedback"
                                id="erreur_nom_1"
                            >
                                Le champ nom ne peut pas être vide. Veuillez insérer un nom.
                            </p>

                        {% else %}

                            <p
                                class="invalid-feedback"
                                id="erreur_nom_2"
                            >
                                Veuillez insérer un nom valide et unique.
                            </p>

                        {% endif %}

                    </div>


                    <div class="mb-3">

                        <label
                            for="courriel"
                            class="form-label"
                        >
                            Courriel :
                        </label>

                        <input
                            type="email"
                            name="courriel"
                            id="courriel"
                            value="{{ courriel }}"
                            class="{{ classe_courriel }} form-control"
                        >


                        {% if num_courriel_erreur == 1 %}

                            <p
                                class="invalid-feedback"
                                id="erreur_courriel_1"
                            >
                                Le champ courriel ne peut pas être vide. Veuillez insérer un courriel.
                            </p>

                        {% elif num_courriel_erreur == 2 %}

                            <p
                                class="invalid-feedback"
                                id="erreur_courriel_2"
                            >
                                Veuillez insérer un courriel valide.
                            </p>

                        {% elif num_courriel_erreur == 3 %}

                            <p
                                class="invalid-feedback"
                                id="erreur_courriel_3"
                            >
                                Votre courriel doit être unique.
                            </p>

                        {% endif %}

                    </div>


                    <div class="mb-3">

                        <label
                            for="mdp1"
                            class="form-label"
                        >
                            Mot de passe :
                        </label>

                        <input
                            type="password"
                            name="mdp1"
                            id="mdp1"
                            value="{{ mdp1 }}"
                            class="{{ classe_mdp1 }} form-control"
                        >

                        <p
                            class="invalid-feedback"
                            id="erreur_mdp1"
                        >
                            Veuillez insérer un mot de passe.
                        </p>

                    </div>


                    <div class="mb-3">

                        <label
                            for="mdp2"
                            class="form-label"
                        >
                            Valider le mot de passe :
                        </label>

                        <input
                            type="password"
                            name="mdp2"
                            id="mdp2"
                            value="{{ mdp2 }}"
                            class="{{ classe_mdp2 }} form-control"
                        >


                        {% if num_mdp_erreur == 1 %}

                            <p
                                class="invalid-feedback"
                                id="erreur_mdp2"
                            >
                                Veuillez réinsérer votre mot de passe.
                            </p>

                        {% else %}

                            <p
                                class="invalid-feedback"
                                id="erreur_mdp2"
                            >
                                Les deux mots de passe ne sont pas identiques. Veuillez réinsérer votre mot de passe.
                            </p>

                        {% endif %}

                    </div>


                    <div class="mb-3">

                        <label
                            for="image"
                            class="form-label"
                        >
                            Image de profil :
                        </label>

                        <input
                            type="file"
                            name="image"
                            id="image"
                            accept=".png,.jpg,.jpeg"
                            class="form-control {% if erreur_image %}is-invalid{% endif %}"
                        >

                        {% if erreur_image %}

                            <p class="invalid-feedback">
                                {{ erreur_image }}
                            </p>

                        {% endif %}

                    </div>


                    <div class="actions-compte d-flex justify-content-end">

                        <button
                            type="submit"
                            id="compteSoumis"
                            class="btn"
                        >
                            Créer mon compte
                        </button>

                    </div>


                    <p class="mb-5">

                        Vous avez déjà un compte ?

                        <a
                            href="/compte/authentification"
                            class="lien-compte"
                        >
                            Me connecter
                        </a>

                    </p>

                </form>

            </div>

        </div>

    </div>

</div>

{% endblock %}